programa {
  funcao inicio() {
     
     inteiro dia_1, dia_2, dia_3, dia_4, dia_5, total

     escreva("Digite o valor de segunda: ")
     leia(dia_1)

     escreva("Digite o valor de terça: ")
     leia(dia_2)

      escreva("Digite o valor de quarta: ")
     leia(dia_3)

      escreva("Digite o valor de quinta: ")
     leia(dia_4)

      escreva("Digite o valor de sexta: ")
     leia(dia_5)

     total=dia_1+dia_2+dia_3+dia_4+dia_5

     escreva("O valor ganho na semana foi: ",total)
  }
}
