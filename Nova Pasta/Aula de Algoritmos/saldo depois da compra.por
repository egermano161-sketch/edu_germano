programa {
  funcao inicio() {
     
     inteiro saldo, compra, total

     escreva("Digite o saldo atual: ")
     leia(saldo)

    escreva("Digite o valor da compra: ")
     leia(compra)
   

total=saldo - compra

     escreva("o saldo atual: ",saldo)
     escreva("\n valor da compra: ",compra)
     escreva("\n valor depois da compra: ",total)
  }
}
