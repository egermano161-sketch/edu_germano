programa {
  funcao inicio() {
     
     inteiro num_1, num_2, num_3, media

     escreva("Digite o Primeiro valor: ")
     leia(num_1)

     escreva("Digite o Segundo valor: ")
     leia(num_2)

     escreva("Digite o Terceiro valor: ")
     leia(num_3)
   

media=(num_1 + num_2 + num_3)/3

     escreva("o Volume é: ",media)
  }
}
