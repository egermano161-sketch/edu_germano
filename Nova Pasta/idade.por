programa
{
	
	funcao inicio()
	
	{
	inteiro anonasc, idade,total
		escreva("Digite o ano que nasceu: ")
		leia(anonasc)

	idade= 2026
	total=idade-anonasc

	escreva ("O ano que nasceu é: \n",anonasc)
	escreva ("Você tem: \n", total)
	}
}
